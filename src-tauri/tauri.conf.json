{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wipe Cause",
  "version": "0.15.0",
  "identifier": "gg.wipecause.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wipe Cause",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://nether.wowhead.com https://wow.zamimg.com https://assets.rpglogs.com data:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://wow.zamimg.com https://assets.rpglogs.com; media-src 'self' asset: http://asset.localhost https:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5OTk0OTgyOTQ2NkFDMTgKUldRWXJHYVVna21aaVdBbkdmOE1ITUZiVzZUYThRbnp6L0U5eERadmQ0ZVQrWk1YUnN1aWRYbWEK",
      "endpoints": [
        "https://github.com/keter45/wipe-cause/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
